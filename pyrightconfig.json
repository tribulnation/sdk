{
  // No implicit Any where the real type is knowable. The parameter rules flag the cause
  // (an unannotated parameter); the Unknown* rules flag each place that Any then spreads
  // to. The count is a backlog to drive to zero, not a gate expected to be green today.
  "typeCheckingMode": "standard",
  "pythonVersion": "3.11",
  "venvPath": ".",
  "venv": ".venv",
  // The PoC scripts under poc/ are notebooks in text form (top-level await, names
  // redefined per cell); `sdk-dev poc check` type-checks them with the right pragmas.
  "exclude": ["**/poc/**", "**/node_modules", "**/__pycache__", "**/.*"],

  "reportMissingParameterType": "error",
  "reportUnknownParameterType": "error",
  "reportUnknownArgumentType": "error",
  "reportUnknownVariableType": "error",
  "reportUnknownMemberType": "error",
  "reportUnknownLambdaType": "error"
}
